# Database Configuration
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_suite_db

# API Configuration
API_HOST=127.0.0.1
API_PORT=8005

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:3000,null

# En una instalación de Electron puedes copiar este archivo como .env en:
# %APPDATA%\Mnemos galery\
