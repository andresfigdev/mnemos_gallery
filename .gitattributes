# Normalize text files in the repository to LF.
* text=auto eol=lf

# Native Windows command scripts use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be modified by line-ending normalization.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.exe binary
